# Copy to .env and fill in. Never commit .env.

# --- Security -----------------------------------------------------------------
# Encrypts Gmail OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Deployment only (leave empty for local use) ------------------------------------
# Public hostname, e.g. parthhunt.duckdns.org. Used by docker-compose.prod.yml for HTTPS + OAuth.
DOMAIN=
# Login password for the web UI. REQUIRED when deployed (the backend refuses to start without it).
APP_PASSWORD=

# --- LLM (Groq) -----------------------------------------------------------------
# https://console.groq.com/keys  - without it, suggestions/tailoring use rules & templates.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_DAILY_CAP=300

# --- Gmail (Google Cloud OAuth "Web application" client) -------------------------
# The only address RemoteHunt ever sends to (your digest); must match the connected account.
GMAIL_ADDRESS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# or point to the downloaded JSON instead of the two values above:
# GOOGLE_CLIENT_SECRETS_FILE=/path/to/client_secret.json
OAUTH_REDIRECT_URI=http://localhost:8765/api/gmail/auth/callback
FRONTEND_URL=http://localhost:5173

# --- Job APIs (optional) ----------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_AFFID=

# --- Runtime ------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://remotehunt:remotehunt@localhost:5432/remotehunt
SCHEDULER_ENABLED=true
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
