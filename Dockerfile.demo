# Public showcase image: one small container (API + built UI), fictional demo data, no torch.
# Runs in <512 MB RAM, so it fits free tiers (Render, Koyeb, Railway trial, Fly.io).
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ .
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEMO_MODE=true \
    SCHEDULER_ENABLED=false \
    EMBEDDING_BACKEND=hashing \
    STATIC_DIR=/app/static \
    DATA_DIR=/tmp/remotehunt
WORKDIR /app
COPY backend/requirements-core.txt backend/
RUN pip install --no-cache-dir -r backend/requirements-core.txt
COPY backend/app backend/app
COPY config config
COPY --from=web /web/dist static
WORKDIR /app/backend
EXPOSE 8000
# Render/Railway/Koyeb inject $PORT; the demo DB lives in /tmp and is re-seeded on every start.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
